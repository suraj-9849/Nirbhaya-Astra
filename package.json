{
  "name": "women-safety",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "concurrently \"turbo run dev\" \"cd apps && python -m uvicorn backend.main:app\" ",
    "generate": "npx prisma generate --cwd apps/frontend",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "concurrently": "^8.2.2",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}